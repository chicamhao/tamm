/* Dev overlay (F2 chapter stepper) — Game.Debug only. */

.debug-screen {
    position: absolute;
    left: 10px;
    top: 10px;
    width: 300px;
    background-color: rgba(10, 10, 10, 0.88);
    border-radius: 4px;
    border-width: 1px;
    border-color: #666;
    padding: 8px 12px;
    flex-direction: column;
    align-items: flex-start;
}

.debug-screen > Label {
    font-size: 14px;
    color: #eeeeee;
    margin: 1px 0;
}

.debug-title {
    font-size: 15px;
    -unity-font-style: bold;
    color: #ffd479;
    margin-bottom: 4px;
}