.card-panel {
    width: 480px;
    max-height: 560px;
    flex-direction: column;
    align-items: stretch;
}

.card-list {
    flex-direction: column;
    gap: 10px;
    margin-top: 8px;
    overflow-y: auto;
}

.card-button {
    font-size: 19px;
    -unity-font-style: bold;
    color: var(--ink);
    background-color: var(--fill);
    border-radius: 8px;
    border-width: 2px;
    border-color: var(--ink);
    padding-top: 10px;
    padding-bottom: 10px;
    -unity-text-align: middle-center;
}

.card-button:hover {
    background-color: #ffffff;
}

.card-empty {
    margin-top: 8px;
    font-size: 15px;
    color: var(--chip-idle);
    -unity-text-align: middle-center;
}