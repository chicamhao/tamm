/* Rat minigame HUD — native UITK shapes (restyle; was uGUI procedural icons). */

.rat-hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* ---------- top-left HUD texts ---------- */

.hud-round {
    position: absolute;
    left: 18px;
    top: 14px;
    font-size: 29px;
    -unity-font-style: bold;
    color: var(--white);
}

.hud-hearts {
    position: absolute;
    left: 18px;
    top: 64px;
    font-size: 22px;
    color: var(--fill);
}

/* ---------- step chips (top centre) ---------- */

.chip-row {
    position: absolute;
    left: 50%;
    top: 12px;
    transform: translateX(-50%);
    flex-direction: row;
    align-items: center;
}

.chip {
    width: 108px;
    flex-direction: column;
    align-items: center;
}

.chip-disc {
    width: 62px;
    height: 62px;
    border-radius: 31px;
    background-color: var(--chip-idle);
    border-width: 4px;
    border-color: var(--ink);
    align-items: center;
    justify-content: center;
}

.chip-glyph {
    font-size: 30px;
    color: var(--ink);
    -unity-text-align: middle-center;
}

.chip-glyph-tap {
    width: 20px;
    height: 20px;
    border-radius: 10px;
    border-width: 3px;
    border-color: var(--ink);
    background-color: transparent;
}

.chip-caption {
    margin-top: 4px;
    width: 108px;
    font-size: 15px;
    color: var(--chip-idle);
    -unity-text-align: middle-center;
}

.chip.active .chip-disc {
    background-color: var(--fill);
    transform: scale(1.18, 1.18);
    transition: transform 0.14s ease-in;
}

.chip.active .chip-caption {
    color: var(--white);
}

.chip.done .chip-disc {
    background-color: var(--chip-done);
}

.chip.done .chip-caption {
    opacity: 0.55;
}

.chip.inactive .chip-caption {
    opacity: 0.35;
}

.chip.inactive .chip-glyph {
    opacity: 0.35;
}

/* ---------- main prompt block ---------- */

.prompt-root {
    position: absolute;
    left: 0;
    top: 0;
}

.prompt-icon {
    position: absolute;
    left: 50%;
    top: 88px;
    transform: translate(-50%, -50%);
    align-items: center;
    justify-content: center;
}

.arrow-up {
    font-size: 88px;
    color: var(--fill);
    -unity-text-outline-width: 6px;
    -unity-text-outline-color: var(--ink);
    -unity-text-align: middle-center;
}

.sweep-hint {
    font-size: 46px;
    color: var(--fill);
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: var(--ink);
    -unity-text-align: middle-center;
}

.tap-disc {
    width: 100px;
    height: 100px;
    border-radius: 50px;
    background-color: var(--fill);
    border-width: 6px;
    border-color: var(--ink);
}

.ripple {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    border-width: 2px;
    border-color: var(--ink);
    background-color: rgba(0, 0, 0, 0);
    opacity: 0;
}

.prompt-label {
    position: absolute;
    left: 50%;
    top: 158px;
    transform: translateX(-50%);
    font-size: 30px;
    -unity-font-style: bold;
    color: var(--white);
    -unity-text-align: middle-center;
}

.prompt-count {
    position: absolute;
    left: 50%;
    top: 200px;
    transform: translateX(-50%);
    font-size: 22px;
    color: var(--chip-idle);
    -unity-text-align: middle-center;
}

/* ---------- instruction / progress / result ---------- */

.hud-instruction {
    position: absolute;
    left: 50%;
    bottom: 96px;
    transform: translateX(-50%);
    font-size: 30px;
    -unity-font-style: bold;
    color: var(--white);
    -unity-text-align: middle-center;
}

.hud-progress {
    position: absolute;
    left: 50%;
    bottom: 56px;
    transform: translateX(-50%);
    font-size: 22px;
    color: var(--chip-idle);
    -unity-text-align: middle-center;
}

.hud-result {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    font-size: 52px;
    -unity-font-style: bold;
    color: var(--white);
    -unity-text-align: middle-center;
    white-space: normal;
    text-wrap: wrap;
}