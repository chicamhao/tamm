.dialogue-screen {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    top: auto;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 48px;
}

.dialogue-box {
    width: 64%;
    max-width: 760px;
    background-color: var(--panel-bg);
    border-radius: 12px;
    border-width: 2px;
    border-color: var(--ink);
    padding: 16px 22px;
    flex-direction: column;
}

.speaker {
    font-size: 17px;
    color: var(--fill);
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.line {
    font-size: 22px;
    color: var(--white);
    flex-wrap: wrap;
}