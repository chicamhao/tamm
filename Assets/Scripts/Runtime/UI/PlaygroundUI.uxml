<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:Style src="common.uss" />
    <ui:Style src="settings-screen.uss" />
    <ui:Style src="card-screen.uss" />
    <ui:Style src="dialogue-screen.uss" />
    <ui:Style src="toast-screen.uss" />
    <ui:Style src="tutorial-screen.uss" />
    <ui:Style src="../../Debug/UI/debug-screen.uss" />

    <!-- ============ Settings (Pause) screen ============ -->
    <ui:VisualElement name="SettingsScreen" class="screen" style="display: none;">
        <ui:VisualElement class="dim" picking-mode="Position" />
        <ui:VisualElement class="panel settings-panel">
            <ui:Label class="title" text="Settings" />
            <ui:VisualElement class="settings-slider-row">
                <ui:Label text="Mouse sensitivity" />
                <ui:Slider name="SensitivitySlider" class="sensitivity-slider" low-value="0.25" high-value="4" value="1" />
                <ui:Label name="SensitivityValue" class="sensitivity-value" text="1x" />
            </ui:VisualElement>
            <ui:VisualElement class="settings-buttons">
                <ui:Button name="SaveButton" class="btn" text="Save" />
                <ui:Button name="LoadButton" class="btn" text="Load" />
                <ui:Button name="NewGameButton" class="btn" text="New Game" />
            </ui:VisualElement>
            <ui:Label class="settings-hint" text="Sensitivity applies to mouse look." />
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- ============ Card selection screen ============ -->
    <ui:VisualElement name="CardScreen" class="screen" style="display: none;">
        <ui:VisualElement class="dim" picking-mode="Position" />
        <ui:VisualElement class="panel card-panel">
            <ui:Label class="title" text="Use a card" />
            <ui:Label name="CardEmpty" class="card-empty" text="No cards to use." />
            <ui:VisualElement name="CardList" class="card-list" />
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- ============ Dialogue screen ============ -->
    <ui:VisualElement name="DialogueScreen" class="dialogue-screen" style="display: none;">
        <ui:VisualElement class="dialogue-box">
            <ui:Label name="SpeakerText" class="speaker" text="" />
            <ui:Label name="LineText" class="line" text="" />
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- ============ Card-granted toasts ============ -->
    <ui:VisualElement name="ToastsHost" class="toasts-host" picking-mode="Ignore" />

    <!-- ============ First-run tutorial hint (builds only) ============ -->
    <ui:VisualElement name="TutorialBox" class="tutorial-box" style="display: none;" picking-mode="Ignore">
        <ui:Label class="tutorial-title" text="Controls" />
        <ui:Label text="Move: WASD       Look: Mouse" />
        <ui:Label text="Interact: E      Pause: P" />
        <ui:Label text="Interact with objects to collect cards," />
        <ui:Label text="then use them when talking to people." />
    </ui:VisualElement>

    <!-- ============ Screen-space world labels (WorldTag, minigame badges) ============ -->
    <ui:VisualElement name="WorldLabels" class="world-labels" picking-mode="Ignore" />

    <!-- ============ Dev debug overlay (Game.Debug, dev/editor builds only) ============ -->
    <ui:VisualElement name="DebugScreen" class="debug-screen" style="display: none;" picking-mode="Position">
        <ui:Label name="DebugTitle" text="DEBUG — F2 close" />
        <ui:Label name="DebugChapter" text="Chapter: -" />
        <ui:Label name="DebugCards" text="Cards: -" />
        <ui:Label name="DebugHint" text="↑ advance chapter   ↓ back a chapter" />
    </ui:VisualElement>
</ui:UXML>