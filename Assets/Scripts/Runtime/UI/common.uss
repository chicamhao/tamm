/* Runtime UI shared palette + base classes.
   Palette mirrors the values that lived on ActionPromptPanel / PromptIcon. */

:root {
    --ink:        #0f3e9e;
    --fill:       #9ed9ff;
    --chip-done:  #8ccc94;
    --chip-idle:  #d6dce5;
    --panel-bg:   rgba(18, 26, 42, 0.94);
    --dim:        rgba(4, 10, 22, 0.45);
    --white:      #ffffff;
}

/* ---------- generic screen scaffolding ---------- */

.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    /* flex-centering (not transform/translate: rejected by this USS parser -> panels drift) */
    display: flex;
    align-items: center;
    justify-content: center;
}

.dim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--dim);
}

.panel {
    background-color: var(--panel-bg);
    border-radius: 14px;
    border-width: 2px;
    border-color: var(--ink);
    padding: 24px;
}

.title {
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--fill);
    -unity-text-align: middle-center;
    margin-bottom: 12px;
}

.caption {
    font-size: 16px;
    color: var(--chip-idle);
}

/* ---------- buttons ---------- */

.btn {
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--ink);
    background-color: var(--fill);
    border-radius: 8px;
    border-width: 2px;
    border-color: var(--ink);
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 18px;
    padding-right: 18px;
    -unity-text-align: middle-center;
}

.btn:hover {
    background-color: #ffffff;
}

.btn:active {
    background-color: var(--ink);
    color: var(--fill);
}

.row-top {
    flex-direction: row;
    gap: 12px;
}

/* ---------- toasts ---------- */

.toasts-host {
    position: absolute;
    top: 12px;
    right: 12px;
    flex-direction: column;
    gap: 8px;
    align-items: flex-end;
}

.toast {
    background-color: var(--panel-bg);
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--ink);
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 14px;
    padding-right: 14px;
    font-size: 16px;
    color: var(--fill);
    opacity: 1;
}

/* ---------- world labels (screen-space projection host) ---------- */

.world-labels {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* One Interactable tag (WorldLabel): a small chip translated to the owner's
   on-screen position. Absolutely positioned so siblings never lay it out. */
.world-label {
    position: absolute;
    left: 0;
    top: 0;
    background-color: var(--panel-bg);
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--ink);
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 10px;
    padding-right: 10px;
    font-size: 15px;
    color: var(--fill);
    -unity-text-align: middle-center;
}

/* ---------- tutorial (exported builds only) ---------- */

.tutorial-box {
    position: absolute;
    left: 16px;
    top: 16px;
    width: 380px;
    background-color: var(--panel-bg);
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--ink);
    padding: 10px 14px;
}

.tutorial-box > Label {
    font-size: 15px;
    color: var(--chip-idle);
    margin: 2px 0;
}

.tutorial-title {
    font-size: 17px;
    color: var(--fill);
    -unity-font-style: bold;
    margin-bottom: 4px;
}