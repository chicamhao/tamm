%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 03bd216766ba8ef40a7a05a9b2ead2e6, type: 3}
  m_Name: DialogueSettings
  m_EditorClassIdentifier: Game.Runtime::Game.Content.DialogueSettings
  Entries:
  - key: card_betelPalmRoot_cam
    value:
      Lines:
      - Line: "M\u1EB9 b\u1EA3o c\xE2y m\u1EE5c r\u1ED3i, \u0111\u1ED1n \u0111i cho an to\xE0n."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "S\u1EE3 tr\u1EDDi m\u01B0a b\xE3o r\u1ED3i l\u1EA1i c\xF3 th\xEAm tai n\u1EA1n n\u1EEFa Th\u1EA7y \u1EA1."
        DisplayDuration: 3
        ExpressionId: expr_default
      RewardCardId: 
  - key: card_betelPalmRoot_sm
    value:
      Lines:
      - Line: "\xC0, c\xE1i g\u1ED1c c\xE2y ngo\xE0i s\xE2n \u0111\u1EA5y h\u1EA3 Th\u1EA7y? C\xE2y \u0111\xF3 m\u1EE5c qu\xE1 t\xF4i \u0111\u1ED1n \u0111i r\u1ED3i, \u0111\u1EC3 l\u1EA1i gi\xF3 b\xE3o n\xF3 \u0111\u1ED5 v\xE0o nh\xE0 th\xEC kh\u1ED1n."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "Nh\xE0 kh\xF4ng c\xF3 \u0111\xE0n \xF4ng, m\u1ED9t n\xEAn t\xF4i quen tay ba c\xE1i vi\u1EC7c n\u1EB7ng nh\u1ECDc n\xE0y."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "D\xF9 l\xE0 ph\u1EE5 n\u1EEF, nh\u01B0ng khi c\u1EA7n, t\xF4i c\u0169ng c\xF3 th\u1EC3 m\u1ECDi th\u1EE9 Th\u1EA7y \u1EA1."
        DisplayDuration: 3
        ExpressionId: expr_default
      RewardCardId: 
  - key: card_betelPalmRoot_tao
    value:
      Lines:
      - Line: "T1: C\xE1i c\xE2y cao, xum xu\xEA th\u1EBF m\xE0 b\u1ECB \u0111\u1ED1n, u\u1ED5ng qu\xE1 hen."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "TC: B\xE0 m\u1EB9 b\u1EA3o t\xF4i l\xE0 c\xE2y m\u1EE5c r\u1ED3i n\xEAn b\xE0 m\u1EDBi \u0111\u1ED1n m\xE0."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "T2: Th\u1EA7y tin ng\u01B0\u1EDDi qu\xE1 r\u1ED3i, th\u1EA7y kh\xF4ng th\u1EA5y con b\xE9 C\xE1m \u0111ang n\u1EB1m li\u1EC7t gi\u01B0\u1EDDng sao, l\xE0 h\u1EADu qu\u1EA3 \u0111\xF3."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "T3: C\xE2y \u0111\xF3 tr\u01B0\u1EDBc gi\u1EDD r\u1EA5t kh\u1ECFe m\u1EA1nh"
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "T1: N\u1EBFu c\xF3 ai kh\xF4ng may t\xE9 ng\xE3, c\xF3 th\u1EC3 kh\xF4ng ph\u1EA3i l\xE0 s\u1EF1 c\u1ED1 \u0111\xE2u th\u1EA7y."
        DisplayDuration: 3
        ExpressionId: expr_default
      RewardCardId: 
  - key: card_bruise_cam
    value:
      Lines:
      - Line: "T\xF4i kh\xF4ng bi\u1EBFt n\xF3 t\u1EEB \u0111\xE2u m\xE0 ra."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "S\xE1ng d\u1EADy t\xF4i \u0111\xE3 th\u1EA5y n\xF3 tr\xEAn tay r\u1ED3i."
        DisplayDuration: 3
        ExpressionId: expr_default
      RewardCardId: 
  - key: card_bruise_sm
    value:
      Lines:
      - Line: "Th\u1EA7y tinh m\u1EAFt th\u1EBF! Ch\xE1u n\xF3 \u0111i \u0111\u1EE9ng h\u1EADu \u0111\u1EADu, ch\u1EAFc l\xE0 va v\xE0o \u0111\xE2u \u0111\u1EA5y \u1EA1."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "Th\u1EA7y ch\u1EDB lo, v\xE0i b\u1EEFa l\xE0 l\xE0nh ngay \u1EA5y m\xE0."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "C\xF3 v\u1EBB th\u1EA7y c\u0169ng m\u1EC7t r\u1ED3i, th\u1EA7y n\xEAn \u0111i ngh\u1EC9 s\u1EDBm \u0111i."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "B\xE0 c\xF3 c\u1EA3m th\u1EA5y v\u1EBFt b\u1EA7m \u0111ang lan ra kh\xF4ng?"
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "Th\u1EA7y l\u1EA1i suy ngh\u0129 nhi\u1EC1u r\u1ED3i."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "V\xE0i b\u1EEFa n\u1EEFa l\xE0 n\xF3 kh\u1ECFi \u1EA5y m\xE0 th\u1EA7y"
        DisplayDuration: 3
        ExpressionId: expr_default
      RewardCardId: 
  - key: card_bruise_tao
    value:
      Lines:
      - Line: "T2: V\u1EBFt b\u1EA7m n\xE0y, t\xF4i b\u1EAFt \u0111\u1EA7u th\u1EA5y n\xF3 xu\u1EA5t hi\u1EC7n t\u1EEB \u0111\xEAm h\xF4m kia."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "T1: Con b\xE9 m\u1ED9ng du, ra ngo\xE0i v\xE0 b\u01B0\u1EDBc \u0111\u1EBFn gi\u1EBFng. Th\u1EA7y bi\u1EBFt m\u1ED9ng du h\xF4ng?"
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "T2: \xD4ng hay l\u1EA1c \u0111\u1EC1 qu\xE1, tr\u1EA3 l\u1EDDi \u0111\xFAng tr\u1ECDng t\xE2m cho th\u1EA7y k\xECa."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "T3: D\u01B0\u1EDBi mi\u1EC7ng gi\u1EBFng, c\xF3 g\xEC \u0111\xF3 n\u1EAFm l\u1EA5y c\xE1nh tay con b\xE9."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "TC: C\xE1c \xF4ng b\xE0 n\xF3i g\xEC c\u01A1?"
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "T1: H\xECnh nh\u01B0 t\u1ED1i nay l\xE0 t\u1EDBi l\u1ECBch \u0111\xF3, th\u1EA7y ra coi tr\u1EF1c ti\u1EBFp cho r\xF5."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "T2: V\u1EBFt b\u1EA7m n\xE0y \u1EA3nh h\u01B0\u1EDFng \u0111\u1EBFn sinh m\u1EC7nh con b\xE9, th\u1EA7y kh\xF4ng c\xF3 nhi\u1EC1u th\u1EDDi gian \u0111\xE2u."
        DisplayDuration: 3
        ExpressionId: expr_default
      RewardCardId: 
  - key: card_cam_cam
    value:
      Lines:
      - Line: "T\xF4i t\xEAn l\xE0 C\xE1m. M\u1EB9 b\u1EA3o t\xF4i sinh ra v\xE0o m\xF9a g\u1EB7t, ng\u01B0\u1EDDi th\u01A1m m\xF9i c\xE1m m\u1EDBi n\xEAn \u0111\u1EB7t t\xEAn th\u1EBF."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "T\xF4i kh\u1EDD kh\u1EA1o l\u1EAFm, kh\xF4ng nhanh nh\u1EB9n v\xE0 \u0111\u1EA3m \u0111ang nh\u01B0 ch\u1ECB, c\xF3 g\xEC Th\u1EA7y \u0111\u1EEBng c\u01B0\u1EDDi nh\xE9."
        DisplayDuration: 3
        ExpressionId: expr_default
      RewardCardId: 
  - key: card_cam_sm
    value:
      Lines:
      - Line: "Con t\xF4i n\u0103m nay \u0111\u01B0\u1EE3c m\u01B0\u1EDDi t\xE1m c\xE1i xu\xE2n r\u1ED3i \u0111\u1EA5y Th\u1EA7y \u1EA1."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "Con g\xE1i c\xF3 l\u1EE9a c\xF3 th\xEC, t\xF4i c\u0169ng ch\u1EC9 mu\u1ED1n g\u1EA3 n\xF3 v\xE0o m\u1ED9t nh\xE0 gi\xE0u cho \u1EA5m c\xE1i th\xE2n."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "\u0110\u1EDDi t\xF4i ch\u1ECBu kh\u1ED5 nhi\u1EC1u r\u1ED3i, \u0111\u1EDDi n\xF3 ph\u1EA3i \u0111\u01B0\u1EE3c sung s\u01B0\u1EDBng."
        DisplayDuration: 3
        ExpressionId: expr_default
      RewardCardId: 
  - key: card_cam_tao
    value:
      Lines:
      - Line: "T1: Con b\xE9 nh\u1ECF."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "T2: C\xF4 b\xE9 l\u1EDBn l\xEAn trong c\u0103n nh\xE0 n\xE0y. D\xF9 m\u1EB9 kh\xF4ng cho \u0111\u1ED9ng tay \u0111\u1ED9ng ch\xE2n v\xE0o vi\u1EC7c g\xEC, nh\u01B0ng con b\xE9 hay l\xE9n ph\u1EE5 ch\u1ECB l\u1EAFm."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "T3: T\xF4i th\u1EA5y 2 ch\u1ECB em n\xF3 c\xE3i nhau su\u1ED1t m\xE0."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "T1: Ng\u01B0\u1EDDi ta th\xE2n thi\u1EBFt m\u1EDBi v\u1EADy \xF4ng \u01A1i."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "T1: N\xF3i chung l\xE0 h\xF2a thu\u1EADn \u0111\xF3."
        DisplayDuration: 3
        ExpressionId: expr_default
      RewardCardId: 
  - key: card_chopsticks_sm
    value:
      Lines:
      - Line: "M\u1ED9t \u0111\xF4i l\xE0 c\u1EE7a con T\u1EA5m."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "N\xF3 ch\u1EBFt r\u1ED3i nh\u01B0ng t\xF4i v\u1EABn \u0111\u1EC3 \u0111\u1EA5y th\xF4i."
        DisplayDuration: 3
        ExpressionId: expr_default
      RewardCardId: 
  - key: card_chopsticks_tao
    value:
      Lines:
      - Line: "T3: \u0110\u0169a n\xE0y d\xF9ng \u0111\u1EC3 \u0103n c\u01A1m."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "T2: C\xE1i n\xE0y th\xEC ai c\u0169ng bi\u1EBFt r\u1ED3i \xF4ng."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "T2: Gia \u0111\xECnh n\xE0y kh\xF4ng qu\xE1 \u1EA5m c\xFAng, nh\u01B0ng nh\u1EEFng b\u1EEFa c\u01A1m c\u1EE7a h\u1ECD c\u0169ng kh\xF4ng qu\xE1 l\u1EA1nh l\u1EBDo."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "T1: Cho t\u1EDBi d\u1EA1o g\u1EA7n \u0111\xE2y, nh\xE0 c\xF2n x\xE0i hai \u0111\xF4i th\xF4i."
        DisplayDuration: 3
        ExpressionId: expr_default
      RewardCardId: 
  - key: card_comb_cam
    value:
      Lines:
      - Line: "L\u01B0\u1EE3c n\xE0y ch\u1ECB hay d\xF9ng \u0111\u1EC3 ch\u1EA3i cho t\xF4i n\xE0y, t\u1ED1i n\xE0o c\u0169ng th\u1EBF."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "Ch\u1ECB c\xF2n b\u1EA3o t\xF3c t\xF4i m\u01B0\u1EE3t, sau n\xE0y g\u1EA3 ch\u1ED3ng th\u1EBF n\xE0o c\u0169ng \u0111\u01B0\u1EE3c ng\u01B0\u1EDDi ta th\u01B0\u01A1ng."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "*Player s\u1EBD miss th\xF4ng tin n\xE0y n\u1EBFu ng\u01B0\u1EDDi ch\u01A1i t\u01B0\u01A1ng t\xE1c v\u1EDBi m\u1EB9 k\u1EBF tr\u01B0\u1EDBc*"
        DisplayDuration: 3
        ExpressionId: expr_default
      RewardCardId: 
  - key: card_comb_sm
    value:
      Lines:
      - Line: "Th\u1EA7y... Th\u1EA7y \u01A1i, chi\u1EBFc l\u01B0\u1EE3c n\xE0y v\u1ED1n l\xE0 c\u1EE7a con T\u1EA5m, t\xF4i \u0111\xE3 qu\u0103ng \u0111i r\u1ED3i, sao b\xE2y gi\u1EDD l\u1EA1i \u1EDF \u0111\xE2y."
        DisplayDuration: 3
        ExpressionId: expr_default
      RewardCardId: 
  - key: card_comb_tao
    value:
      Lines:
      - Line: "T3: C\xE2y l\u01B0\u1EE3c n\xE0y con b\xE9 l\u1EDBn v\u1EABn m\u1ED7i t\u1ED1i ch\u1EA3i t\xF3c cho C\xE1m n\xE0y."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "T2: V\u1EEBa ch\u1EA3i v\u1EEBa n\xF3i chuy\u1EC7n r\xF4m r\u1EA3, \u1ED3n nh\u01B0ng vui l\u1EAFm."
        DisplayDuration: 3
        ExpressionId: expr_default
      RewardCardId: 
  - key: card_incense_sm
    value:
      Lines:
      - Line: "Nhang n\xE0y t\xF4i d\xF9ng \u0111\u1EC3 c\xFAng c\xE1c T\xE1o."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "Nh\u01B0ng n\u1EBFu \u0111\u01B0\u1EE3c th\xEC Th\u1EA7y c\xFAng cho con T\u1EA5m \u0111i khu\u1EA5t m\u1EAFt gi\xFAp t\xF4i."
        DisplayDuration: 3
        ExpressionId: expr_default
      RewardCardId: 
  - key: card_incense_tao
    value:
      Lines:
      - Line: "T1: Th\u1EA7y l\xE0m th\u1EA7y c\xFAng m\xE0 c\u0169ng ph\u1EA3i h\u1ECFi \xE0?"
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "T3: Nhang l\xE0 s\u1EE3i d\xE2y k\u1EBFt n\u1ED1i gi\u1EEFa th\u1EF1c t\u1EA1i v\xE0 th\u1EBF gi\u1EDBi t\xE2m linh."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "T1: Nh\u01B0 th\u1EA7y \u0111ang n\xF3i chuy\u1EC7n v\u1EDBi t\u1EE5i t\xF4i n\xE8."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "T2: V\xE0 trong c\xE1c nghi l\u1EC5, nhang l\xE0 1 th\xE0nh ph\u1EA7n quan tr\u1ECDng kh\xF4ng th\u1EC3 thi\u1EBFu."
        DisplayDuration: 3
        ExpressionId: expr_default
      RewardCardId: 
  - key: card_oriole_sm
    value:
      Lines:
      - Line: "\u0110\xEDch th\u1ECB l\xE0 do N\xD3. N\xD3 \u0111ang \xE1m c\xE1i nh\xE0 n\xE0y."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "H\u1ED3n ma c\u1EE7a con T\u1EA5m..."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "Sao ch\u1EBFt r\u1ED3i kh\xF4ng \u0111i cho khu\u1EA5t m\u1EAFt \u0111i, c\xF2n quay l\u1EA1i \xE1m c\xE1i nh\xE0 n\xE0y n\u1EEFa."
        DisplayDuration: 3
        ExpressionId: expr_default
      RewardCardId: 
  - key: card_oriole_tao
    value:
      Lines:
      - Line: "T1: Nh\xECn v\u1EADy ch\u1EE9 kh\xF4ng ph\u1EA3i v\u1EADy, th\u1EA7y coi ch\u1EEBng nh\u1EA7m nh\xE9."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "T2: \u0110\xF3 \u0111\xFAng l\xE0 m\u1ED9t th\u1EF1c th\u1EC3 t\xE0 \xE1c v\xE0 gi\u1EADn d\u1EEF."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "T3: Th\u1EA7y h\xE3y \u0111\u1EC3 \xFD \u0111\u1EBFn ng\u01B0\u1EDDi m\xE0 N\xD3 h\u01B0\u1EDBng t\u1EDBi, th\u1EA7y s\u1EBD \u0111o\xE1n \u0111\u01B0\u1EE3c c\xE2u tr\u1EA3 l\u1EDDi th\u1EA7y \u0111ang t\xECm ki\u1EBFm."
        DisplayDuration: 3
        ExpressionId: expr_default
      RewardCardId: 
  - key: card_pa_cam
    value:
      Lines:
      - Line: "C\xE2y m\u1EDBi m\u1ECDc g\u1EA7n \u0111\xE2y th\xF4i, nh\u01B0ng l\u1EA1 l\u1EAFm Th\u1EA7y \u01A1i, n\xF3 l\u1EDBn nhanh ch\u1EC9 sau 1 \u0111\xEAm."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "\u0110\u1EE9ng g\u1EA7n n\xF3 t\xF4i c\u1EE9 th\u1EA5y nh\u1EE9c h\u1EBFt c\u1EA3 \u0111\u1EA7u, tai c\u1EE9 \xF9 \u0111i nh\u01B0 c\xF3 ti\u1EBFng khung c\u1EEDi g\u1ED7 k\xEAu k\xE8n k\u1EB9t..."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "V\u1EDBi Th\u1EA7y c\xF3 th\u1EA5y \u0111\u1EA5t ch\u1ED7 c\xE2y xoan b\u1ECB \u0111\u1ED9ng kh\xF4ng Th\u1EA7y?"
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "T\xF4i c\u1EE9 c\xF3 c\u1EA3m gi\xE1c c\xE2y \u0111ang chuy\u1EC3n \u0111\u1ED9ng."
        DisplayDuration: 3
        ExpressionId: expr_default
      RewardCardId: 
  - key: card_pa_sm
    value:
      Lines:
      - Line: "L\xE0 c\xE2y d\u1EA1i \u0111\xF3 th\u1EA7y."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "V\u01B0\u1EDDn t\u01B0\u1EE3c b\u1ECF hoang d\u1EA1o m\u01B0a gi\xF3 n\xE0y c\u1ECF c\xE2y m\u1ECDc um t\xF9m."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "N\xF3 m\u1EDBi xu\u1EA5t hi\u1EC7n g\u1EA7n \u0111\xE2y th\xF4i,"
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "tr\xF9ng h\u1EE3p..."
        DisplayDuration: 3
        ExpressionId: expr_default
      RewardCardId: 
  - key: card_pa_tao
    value:
      Lines:
      - Line: "T1: C\xE1i c\xE2y \u0111\xF3 ch\xFAng t\xF4i c\u0169ng th\u1EAFc m\u1EAFc."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "TC: C\xE1c \xF4ng b\xE0 m\xE0 c\u0169ng th\u1EAFc m\u1EAFc \xE0?"
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "T2: Ch\xFAng t\xF4i bi\u1EBFt n\xF3 l\xE0 g\xEC, nh\u01B0ng m\u1ECDc qua \u0111\xEAm m\xE0 cao qu\xE1 \u0111\u1EA7u ng\u01B0\u1EDDi th\xEC kh\xE1 \u1EA5n t\u01B0\u1EE3ng \u0111\xF3."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "T3: C\xE2y \u0111\xF3 \u0111ang c\u1ED1 v\xE0o trong nh\xE0..."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "T1: Nh\u01B0ng ch\u01B0a v\xE0o \u0111\u01B0\u1EE3c h\u1EB3n"
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "T3: T\xF4i v\u1EEBa \u0111\u1ECBnh n\xF3i."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "T1: T\xF4i bi\u1EBFt."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "TC: Hai \xF4ng \u0111\u1ECDc \xFD nhau v\u1EADy \xE0?"
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "T1: Ch\xFAng t\xF4i ng\u1ED3i c\xF9ng nhau m\u1EA5y ng\xE0n n\u0103m, kh\xF4ng \u0111\u1ECDc \u0111\u01B0\u1EE3c nhau m\u1EDBi l\u1EA1."
        DisplayDuration: 3
        ExpressionId: expr_default
      RewardCardId: 
  - key: card_sm_cam
    value:
      Lines:
      - Line: "M\u1EB9 t\xF4i gi\u1ECFi l\u1EAFm Th\u1EA7y."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "H\u01A1n 10 n\u0103m nay, 1 m\xECnh m\u1EB9 lo cho c\u1EA3 2 ch\u1ECB em."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "D\xF9 m\u1EB9 c\xF3 nhi\u1EC1u l\xFAc kh\xF3 t\xEDnh, nh\u01B0ng t\xF4i qu\xFD m\u1EB9 l\u1EAFm."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "Nh\u01B0ng d\u1EA1o n\xE0y kh\xF4ng hi\u1EC3u sao m\u1EB9 kh\xF4ng ng\u1EE7 \u0111\u01B0\u1EE3c, c\u1EE9 hay b\u1ED3n ch\u1ED3n \u0111i l\u1EA1i."
        DisplayDuration: 3
        ExpressionId: expr_default
      RewardCardId: 
  - key: card_sm_sm
    value:
      Lines:
      - Line: "Nh\xE0 t\xF4i gi\u1EDD ch\u1EC9 c\xF2n hai m\u1EB9 con n\u01B0\u01A1ng t\u1EF1a v\xE0o nhau th\xF4i Th\u1EA7y \u1EA1."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "L\xE0 m\u1EB9 m\xE0, \u0111\u01B0\u01A1ng nhi\xEAn t\xF4i mu\u1ED1n d\xE0nh h\u1EBFt t\u1EA5t c\u1EA3 nh\u1EEFng g\xEC t\u1ED1t \u0111\u1EB9p nh\u1EA5t cho con m\xECnh."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "\u0110\u1EDDi t\xF4i coi nh\u01B0 b\u1ECF, nh\u01B0ng con C\xE1m th\xEC ph\u1EA3i \u0111\u01B0\u1EE3c \u0111\u1EE7 \u0111\u1EA7y, kh\xF4ng \u0111\u1EC3 n\xF3 thua k\xE9m ai c\xE1i g\xEC c\u1EA3."
        DisplayDuration: 3
        ExpressionId: expr_default
      RewardCardId: 
  - key: card_sm_tao
    value:
      Lines:
      - Line: "T3: B\xE0 \u1EA5y c\xF3 nhi\u1EC1u n\u1ED7i s\u1EE3."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "T3: S\u1EE3 con C\xE1m kh\xF4ng c\xF3 ch\u1ED7 \u0111\u1EE9ng, s\u1EE3 ng\u01B0\u1EDDi kh\xE1c l\u1EA5y h\u1EBFt ph\u1EA7n c\u1EE7a con b\xE0 ch\u1EC9 b\u1EB1ng c\xE1ch t\u1ED3n t\u1EA1i."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "T2: N\xF3i chung l\xE0 b\xE0 lo cho con m\xECnh."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "T1: Lo qu\xE1 m\u1EE9c lu\xF4n."
        DisplayDuration: 3
        ExpressionId: expr_default
      RewardCardId: 
  - key: card_wine_sm
    value:
      Lines:
      - Line: "R\u01B0\u1EE3u n\xE0y t\xF4i hay d\xF9ng \u0111\u1EC3 c\xFAng cho c\xE1c T\xE1o."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "Nh\u01B0ng d\u1EA1o n\xE0y nhi\u1EC1u chuy\u1EC7n x\u1EA3y ra, t\xF4i ph\u1EA3i u\u1ED1ng th\xEC m\u1EDBi ch\u1EE3p m\u1EAFt \u0111\u01B0\u1EE3c Th\u1EA7y \u1EA1."
        DisplayDuration: 3
        ExpressionId: expr_default
      RewardCardId: 
  - key: card_wine_tao
    value:
      Lines:
      - Line: "T2: R\u01B0\u1EE3u n\xE0y b\xE0 m\u1EB9 hay r\xF3t cho ch\xFAng t\xF4i u\u1ED1ng."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "T1: Nh\u01B0ng ch\u1EB3ng hi\u1EC3u l\xE0m sao d\u1EA1o g\u1EA7n \u0111\xE2y b\xE0 c\u1EE9 l\u1EA5y u\u1ED1ng lu\xF4n."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "T1: G\u1EA7n h\u1EBFt b\xECnh r\u1ED3i m\xE0 ch\u01B0a th\u1EA5y b\xE0 mua th\xEAm, th\u1EA7y nh\u1EAFc kh\xE9o b\xE0 \u1EA5y gi\xF9m ch\xFAng t\xF4i."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "T3: Trong c\xE1c nghi l\u1EC5 c\u0169ng c\u1EA7n r\u01B0\u1EE3u n\u1EEFa."
        DisplayDuration: 3
        ExpressionId: expr_default
      - Line: "T1: V\u1EADy ph\u1EA3i \u0111i mua th\xEAm th\xF4i."
        DisplayDuration: 3
        ExpressionId: expr_default
      RewardCardId: 
